{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cksdnr1/genesis-organism/schemas/synthetic/adaptation-v1/origin.schema.json",
  "description": "Synthetic shape only; D03 canonical bytes/proofs and D04 semantics require separate validation.",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "synthetic-v1"
        },
        "rules": {
          "const": "adaptation-v1"
        },
        "birth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+$"
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authority": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "genome": {
          "type": "object",
          "properties": {
            "signal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "signal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "rules",
        "birth",
        "creator",
        "authority",
        "genome"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "body",
    "signature"
  ],
  "additionalProperties": false
}
