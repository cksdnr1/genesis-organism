{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cksdnr1/genesis-organism/schemas/synthetic/core-v1/state.schema.json",
  "description": "Synthetic shape only; D03 canonical bytes/proofs and D04 semantics require separate validation.",
  "type": "object",
  "properties": {
    "profile": {
      "const": "synthetic-v1"
    },
    "rules": {
      "const": "core-v1"
    },
    "organism": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    }
  },
  "required": [
    "profile",
    "rules",
    "organism",
    "authority",
    "sequence",
    "head",
    "signal"
  ],
  "additionalProperties": false
}
